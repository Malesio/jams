setCpm(134/4)

$: s("bd").bank("ry30").seg(4).dec(.1).dist(.9).gain(2).bpf(500).bpq(.8).duck("3:4:5").duckattack(.16).duckdepth(.8)
$: s("hh").bank("tr808").seg(12).gain(.5)
$: s("sd").bank("tr909").struct("[~ x]*2").dec(.1).diode(2.5).gain(.3)

$: n("0").scale("d1:minor")
  .s("saw").struct("[~ x x ~ x x ~ ~ x ~ x x]")
  .add(note("-0.3,0,0.2"))
  .fm(.3).fmh(1.5).fmwave("brown")
  .lpf(200).lpenv(slider(2.7, 0, 9)).lpq(2).lps(.06).lpd(.1)
  .dist("2.5:.6")
  .disttype("asym")
  .postgain(.6)
  .o(3)
  ._scope()

$: n(irand(11).fast(8).rib(1, 1)).scale("d2:phrygian")
  .s("supersaw,saw").struct("[x ~ x x x ~ ~ x ~ x ~ x]")
  .unison(5).detune(.4).spread(.85)
  .fm(3).fmwave("square")
  .lpf(900).lpenv(slider(6.795, 0, 9)).lpq(2).lps(.06).lpd(.1)
  .dist("3.5:.2")
  .disttype("chebyshev")
  .compressor("-20:20:10")
  .delay(.1)
  .room(.6).size(1)
  .o(4)
  ._scope()

$: n("<0@2 [5 2] 3 4 [1 -1]>").scale("d6:phrygian").seg(2)
  .s("supersaw")
  .unison(7).detune(.9).spread(.85)
  .adsr("0.1:.2:0:0")
  .hpf(2000)
  .lpf(6000)
  .crush(4.5)
  .dist("1:.6")
  .disttype("soft")
  .delay(.3)
  .room(2).size(5)
  .postgain(.3)
  .o(5)
