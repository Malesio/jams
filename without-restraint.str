setCpm(132/4)

$: s("bd").seg(4).bank("tr909").dec(.4).duck("3:4:5").duckattack(.2).duckdepth(.9)
$: s("hh").bank("tr909").seg(8).rarely(ply("2")).dec(.4)
$: s("sd").bank("tr909").struct("[~ <x!7 [x ~ ~ x]>]*2").dec(.15).hpf(1200).hpq(.7).diode(3.5).gain(.2).postgain(.8)

$: n("<5 3 0 6>").scale("d1:minor")
  .s("sine").struct("[~ x]*4")
  .dist("2.5:.8")
  .disttype("asym")
  .o(3)
  ._scope()
$: n("<0 [2 1] 0 [2 3]>").scale("d6:minor").scaleTrans("0,-7")
  .s("supersaw,square")//.add(note("-0.05,0.1"))
  .struct("[x ~ x ~ <~ [x ~]> <~ x> ~ <~ x>]*2")
  .unison(3).detune(.6).spread(.85)
  .fm(slider(1.93, 0, 5)).fmwave("crackle")
  .dist("2.5:.6")
  .disttype("chebyshev")
  .lpf(3000)
  .delay(.3)
  .room(.9).size(1.1)
  .gain(.4)
  .postgain(.7)
  .o(4)
  ._scope()

$: anchor("<c5!3 g4>").chord("<Bb Gm Dm C>").voicing()
  .s("supersaw,gm_string_ensemble_1:1")
  .unison(5).detune(.3).spread(.85)
  .hpf(300)
  .dist("1.1:.4")
  .disttype("soft")
  .o(5)
  ._pianoroll()
