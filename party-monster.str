setCpm(138/4)

$: s("bd").bank("ry30").beat("0,3?,6,9?,10,15?", 16).slow(2)
  .lpf(270)
  .gain(2)
  .duck("3:4:5")
  .duckattack(.19)
  .duckdepth(.85)
$: s("hh").bank("tr808").seg(8).gain(1.4).rarely(ply("2 | 3 | 4"))
$: s("cp").bank("tr909").beat("4,7?,9?,12,15?",16).slow(2).dec(.05).diode(4.5).gain(.2)

const scale = "bb3:minor";

$: n("<0 4 5 0 0 4 5 4 0 4 5 4 0 4 5 7>*4").scale(scale).scaleTrans("7,14")
  .s("supersaw")
  .penv(36).patt(.003).pdec(.03)
  .adsr(".001:.4:0:0")
  .unison(7).detune(.5).spread(.85)
  .fm(slider(3.865, 0, 5)).fmwave("sine")
  .lpf(250).lpenv(slider(9, 0, 9)).lpq(2).lps(.16).lpd(.2)
  .dist("1.5:.7")
  .disttype("soft")
  .room(1.3).size(3).roomdim(6000).roomlp(12000)
  .gain(.8)
  .o(3)
  ._scope()

const bassline = "<0 [-1@3 ~] -3 [-2@5 [2 1]@3] 0 [-1 [1 2@3]] -2 [-1 [1 [2 1]@3]]>/2";

$: n(bassline).scale(scale).scaleTrans("-7,-14")
  .s("supersaw")
  .unison(7).detune(.9).spread(.85)
  .fm(slider(4.32, 0, 5)).fmwave("saw")
  .lpf(110).lpenv(slider(9, 0, 9)).lpq(2).lps(.16).lpd(.2)
  .dist("2.5:.4")
  .disttype("diode")
  .chorus(.8)
  .o(4)
  ._scope()

$: n(bassline).scale(scale).scaleTrans(-14)
  .s("triangle")
  .lpf(70).lpenv(1.2)
  .asym("1.9:.9")
  .o(5)
  ._scope()
